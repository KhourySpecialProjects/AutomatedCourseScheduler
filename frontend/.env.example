# =============================================================================
# Frontend (Vite) LOCAL environment. Copy to frontend/.env:
#   cp frontend/.env.example frontend/.env
#
# Vite bakes VITE_* into the static bundle at BUILD time (read by `make fe-dev`
# locally). On Coolify these are passed as build args instead — see
# .env.coolify.example at the repo root. Values here must match the backend
# .env: VITE_AUTH0_* mirror AUTH0_* one-for-one.
# =============================================================================

VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com   # bare host — same as AUTH0_DOMAIN
VITE_AUTH0_CLIENT_ID=your_spa_client_id      # same as AUTH0_SPA_CLIENT_ID
VITE_AUTH0_AUDIENCE=https://acs-api          # same as AUTH0_AUDIENCE
VITE_API_BASE_URL=http://localhost:8000      # backend base (HTTP + WebSocket)
