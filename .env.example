# =============================================================================
# LOCAL DEVELOPMENT environment (laptop). Copy to `.env`:  cp .env.example .env
# For a Coolify / server deployment, use .env.coolify.example instead.
# =============================================================================

# ── Postgres ────────────────────────────────────────────────────────────────
# These defaults are fine for LOCAL dev only. The DB is reachable solely on the
# Docker network + 127.0.0.1 (see docker-compose.yaml). NEVER reuse these creds
# on a server — generate strong values for Coolify (.env.coolify.example).
POSTGRES_USER=scheduler
POSTGRES_PASSWORD=scheduler
POSTGRES_DB=scheduler_db

# Only needed when running the backend OUTSIDE Docker (e.g. `make be-dev`).
# In Docker Compose the api service sets DATABASE_URL directly, so leave unset.
# POSTGRES_HOST=localhost

# ── App URLs ────────────────────────────────────────────────────────────────
# Comma-separated list of frontend origins allowed to call the API (CORS).
CORS_ORIGINS=http://localhost:3000
# Base URL of the frontend, used to build the Auth0 signup redirect.
APP_BASE_URL=http://localhost:3000

# ── Auth0 (backend) ─────────────────────────────────────────────────────────
# AUTH0_DOMAIN: bare tenant host — NO https://, NO trailing slash.
AUTH0_DOMAIN=your-tenant.us.auth0.com
# AUTH0_AUDIENCE: the API "Identifier" you set in Auth0 (Applications > APIs).
AUTH0_AUDIENCE=https://acs-api
# SPA app Client ID (same value as VITE_AUTH0_CLIENT_ID in frontend/.env).
AUTH0_SPA_CLIENT_ID=your_spa_client_id

# ── Frontend (Vite) ──────────────────────────────────────────────────────────
# The frontend has its OWN env file. Copy it separately:
#   cp frontend/.env.example frontend/.env
# Its VITE_AUTH0_* values mirror the AUTH0_* values above one-for-one.
