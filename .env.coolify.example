# =============================================================================
# Coolify deployment environment (dev / staging / prod).
# Set these as environment variables in the Coolify project/service UI — they
# are substituted into docker-compose.coolify.yaml at deploy/build time.
# Do NOT commit a filled-in copy of this file.
# =============================================================================

# ── Postgres ────────────────────────────────────────────────────────────────
# Generate a STRONG, unique password per environment (hex keeps it URL-safe when
# interpolated into DATABASE_URL — base64 can emit +, /, = and break parsing), e.g.:
#   openssl rand -hex 32
# The password is baked into the DB volume on first deploy; changing it later
# requires recreating the volume (data loss) or an ALTER ROLE inside the DB.
POSTGRES_USER=scheduler
POSTGRES_PASSWORD=CHANGE_ME_use_a_generated_secret
POSTGRES_DB=scheduler_db

# Optional: point at a Coolify-managed / external Postgres instead of the bundled
# db service. If set, it overrides the POSTGRES_* values above for the backend.
# Prefer an internal/private host — never a public DB endpoint.
# DATABASE_URL=postgresql://user:password@internal-db-host:5432/scheduler_db

# ── App URLs (use HTTPS, real hostnames, no trailing slash) ──────────────────
# Comma-separated allowlist of frontend origins permitted to call the API.
CORS_ORIGINS=https://app.dev.example.com
# Public base URL of the frontend (Auth0 signup redirect target).
APP_BASE_URL=https://app.dev.example.com

# ── Auth0 (backend) ─────────────────────────────────────────────────────────
# Shared across local/dev/staging for now; use a separate app/tenant for prod.
AUTH0_DOMAIN=your-tenant.us.auth0.com          # bare host, no https://, no /
AUTH0_AUDIENCE=https://acs-api                  # Auth0 API Identifier
AUTH0_SPA_CLIENT_ID=your_spa_client_id

# ── Frontend (Vite) BUILD ARGS ──────────────────────────────────────────────
# These are consumed at IMAGE BUILD time (docker-compose.coolify.yaml build.args)
# and baked into the static bundle. Changing them requires a REBUILD, not just a
# restart. Ensure Coolify passes them at build (not only runtime).
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com      # same as AUTH0_DOMAIN
VITE_AUTH0_CLIENT_ID=your_spa_client_id         # same as AUTH0_SPA_CLIENT_ID
VITE_AUTH0_AUDIENCE=https://acs-api             # same as AUTH0_AUDIENCE
VITE_API_BASE_URL=https://api.dev.example.com   # public API base (HTTP + WS)

# ── Reminder: Auth0 dashboard ────────────────────────────────────────────────
# Add this environment's frontend URL to the SPA app's Allowed Callback URLs,
# Allowed Logout URLs, and Allowed Web Origins, or login will be rejected.
